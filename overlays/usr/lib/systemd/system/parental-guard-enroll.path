[Unit]
Description=parental-os enrollment trigger on account database changes
# Delivers the automatic policy inheritance the design calls for: any account
# created after install is enrolled as soon as it appears, without depending on the
# new user ever opening a login shell.

[Path]
PathChanged=/etc/passwd
PathChanged=/etc/group
Unit=parental-guard-enroll.service

[Install]
WantedBy=multi-user.target
