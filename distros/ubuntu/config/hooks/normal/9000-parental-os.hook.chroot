#!/bin/sh
set -e

DEB_DIR=/root/parental-os-debs
set -- "$DEB_DIR"/parental-guard_*.deb
if [ ! -e "$1" ]; then
    echo "parental-os: missing local parental-guard deb in $DEB_DIR" >&2
    exit 1
fi

dpkg -i "$@" || apt-get -f install -y

if ! getent group parental-users >/dev/null 2>&1; then
    groupadd --system parental-users || groupadd parental-users
fi

mkdir -p /lib/live/config
cat >/lib/live/config/9999-parental-os-user <<'EOF'
#!/bin/sh
set -e

user="${LIVE_USERNAME:-child}"
if getent passwd "$user" >/dev/null 2>&1; then
    /usr/lib/parental-os/user-setup.sh "$user"
fi
EOF
chmod 755 /lib/live/config/9999-parental-os-user

systemctl enable parental-guard.service parental-guard-agent.service >/dev/null 2>&1 || true

rm -rf "$DEB_DIR"
