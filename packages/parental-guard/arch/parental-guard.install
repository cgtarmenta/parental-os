remove_temp_parental_repo() {
  local root="${PARENTAL_OS_PACMAN_ROOT:-}"
  local pacman_conf="${root}/etc/pacman.conf"
  local pacman_more_conf="${root}/etc/pacman-more.conf"
  local repo_dir="${root}/srv/parental-os-repo"

  python3 - "$pacman_conf" "$pacman_more_conf" <<'PYEOF'
import re
import sys

marked = r"^# BEGIN parental-os temporary repository\n\[parental-os\]\n.*?^# END parental-os temporary repository\n?"
unmarked_temp = r"^\[parental-os\]\n(?:(?!^\[[^]\n]+\]\n)[\s\S])*(?:Server = http://127\.0\.0\.1:8765|Server = file:///srv/parental-os-repo)(?:(?!^\[[^]\n]+\]\n)[\s\S])*"

for path in sys.argv[1:]:
    try:
        with open(path, encoding="utf-8") as f:
            content = f.read()
    except FileNotFoundError:
        continue

    new = re.sub(marked, "", content, flags=re.MULTILINE | re.DOTALL)
    new = re.sub(unmarked_temp, "", new, flags=re.MULTILINE | re.DOTALL)
    if new != content:
        with open(path, "w", encoding="utf-8") as f:
            f.write(new)
PYEOF

  rm -rf -- "$repo_dir"
}

post_install() {
  remove_temp_parental_repo
  groupadd --system parental-users 2>/dev/null || groupadd parental-users 2>/dev/null || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  # parental-guard-enroll.{service,path} are what put interactive users into
  # parental-users. Without them the group stays empty and the sudoers policy
  # applies to nobody, which is exactly how an install once looked healthy while
  # enforcing nothing.
  systemctl enable parental-guard.service parental-guard-agent.service \
    parental-guard-enroll.service parental-guard-enroll.path >/dev/null 2>&1 || true
  # Enroll whoever already exists (the account the installer created), rather than
  # waiting for a reboot to apply the policy for the first time.
  if [[ -x /usr/lib/parental-os/enroll-users.sh ]]; then
    /usr/lib/parental-os/enroll-users.sh || true
  fi
}

post_upgrade() {
  post_install
}
